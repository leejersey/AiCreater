{
  "name": "aicreater",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "tsx --test packages/*/tests/*.test.ts apps/web/tests/*.test.ts",
    "test:workflow": ".venv/bin/python -m unittest discover -s services/tests -v",
    "typecheck": "tsc --noEmit",
    "scene-agent": "tsx scripts/scene-agent.ts",
    "web": "next dev apps/web --hostname 127.0.0.1 --port 3000 --webpack",
    "web:build": "next build apps/web",
    "web:start": "next start apps/web --hostname 127.0.0.1 --port 3000",
    "workbench:status": ".venv/bin/python -m services.workbench status",
    "workbench": ".venv/bin/python -m services.workbench run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/lxgw-wenkai": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.0",
    "@fontsource/noto-serif-sc": "5.3.1",
    "@remotion/bundler": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "ajv": "8.20.0",
    "next": "16.4.5",
    "postcss": "8.5.29",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
