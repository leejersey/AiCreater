# Copy to .env locally; never send real keys in chat or commit them.
DEEPSEEK_API_KEY=
# Set the model available to your DeepSeek account; change if this identifier is unavailable.
DEEPSEEK_MODEL=deepseek-flash

# Server-only Fernet key for per-account image API credentials (32 bytes, URL-safe base64).
# Generate once locally; back up separately from the DB. Never use NEXT_PUBLIC_ or rotate blindly.
# Missing/invalid key blocks saving image credentials; it does not prevent login or deletion.
ACCOUNT_CREDENTIALS_KEY=

# New Volcengine console: fill only API_KEY.
VOLCENGINE_API_KEY=
# Legacy VOICE console: leave API_KEY blank, fill BOTH fields below instead.
# ACCESS_KEY is the voice service Access Token, NOT a cloud IAM AccessKey/SecretKey.
VOLCENGINE_APP_ID=
VOLCENGINE_ACCESS_KEY=

# Doubao TTS 2.0 uses native WebSocket subtitles (enable_subtitle), not HTTP enable_timestamp.
# Missing timestamps still fail alignment; no estimated-time fallback.
VOLCENGINE_RESOURCE_ID=seed-tts-2.0
# Default TTS 2.0 voice; confirm it is authorized for your account.
VOLCENGINE_SPEAKER=zh_female_vv_uranus_bigtts

# Optional local PostgreSQL persistence. Configure both locally; never commit credentials.
POSTGRES_PASSWORD=
# URL-encode password characters in the DSN; local compose uses port 15432.
DATABASE_URL=
# Local Redis carries fixed wake-ups only; manuscripts and job state stay in PostgreSQL.
CELERY_BROKER_URL=redis://127.0.0.1:16379/0

# Optional private S3-compatible storage. Blank ENDPOINT keeps existing local-only mode.
# Once configured, failures do NOT fall back to local-only publication.
# HTTP only for loopback/minio; remote endpoints require HTTPS. Never expose these keys to Next.js.
# Names retained for S3 SDK compatibility; bundled service is RustFS, not legacy MinIO.
# To enable compose.storage.yaml use http://127.0.0.1:19000 and unique local credentials.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=aicreater
# Start the pinned Apache-2.0 RustFS service with: docker compose -f compose.storage.yaml up -d
# Existing local assets are uploaded on import/version creation or render validation.
